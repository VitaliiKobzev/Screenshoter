{
  "manifest_version": 3,
  "version": "0.2.0",
  "name": "Screenshoter",
  "description": "Quick access to screenshots",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "permissions": ["storage", "downloads", "activeTab", "tabs"],
  "host_permissions": ["https://basepic.com/*"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Capture screenshot"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://basepic.com;"
  }
}
